config_version=5

[application]

config/name="bullet hell"
run/main_scene="uid://dq024rj3sseom"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*uid://bgq8eao47q3p6"
SettingsManager="*uid://sh0osek64eid"
SoundManager="*res://scripts/singletons/sound_manager.gd"
ArrowManager="*uid://bk7ogpk8resli"
DarkenManager="*uid://32eh6c8miqqw"
DebugManager="*uid://dbiurbp18km0n"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[editor_plugins]

